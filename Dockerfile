# 1. Используем официальный легкий образ Node.js
FROM node:20-alpine

# 2. Создаем рабочую директорию внутри контейнера
WORKDIR /app

# 3. Копируем файлы зависимостей
COPY package*.json ./

# 4. Устанавливаем зависимости
RUN npm install

# 5. Копируем весь исходный код проекта
COPY . .

# 6. Указываем порт, который слушает Express
EXPOSE 3000

# 7. Переменная окружения по умолчанию
ENV PORT=3000

# 8. Команда запуска сервера
CMD ["node", "server.js"]